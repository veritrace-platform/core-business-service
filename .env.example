# Copy to .env for `make run` / `make migrate-up`. Never commit .env.
# Passwords match platform-infrastructure/.env.example.

APP_ENV=development
LOG_LEVEL=debug
HTTP_ADDR=:8080
ADMIN_ADDR=:8081
SHUTDOWN_TIMEOUT=15s

# Runtime role (row-level security applies).
DATABASE_URL=postgres://veritrace_core_app:core-app-dev@localhost:5432/veritrace_core?sslmode=disable

# Schema owner role (migrations only).
MIGRATIONS_DATABASE_URL=postgres://veritrace_core_owner:core-owner-dev@localhost:5432/veritrace_core?sslmode=disable
